# Copie para .env e ajuste (NAO commite o .env)
DB_URL=jdbc:postgresql://<host>:<porta>/library_db?sslmode=require&serverTimezone=UTC
DB_USER=<usuario-do-banco>
DB_PASSWORD=<senha-do-banco>
JWT_SECRET=<segredo-aleatorio-com-pelo-menos-32-caracteres>
ADMIN_EMAIL=admin@library.com
ADMIN_PASSWORD=<senha-do-admin>
PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:5500,http://localhost:5173
